      "name": "Build Error Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst ex = e.execution || {}, wf = e.workflow || {};\nconst err = ex.error || e.trigger?.error || {};\nconst html = `<p><b>${esc(wf.name)}</b> si e' fermato.</p><ul>`\n  + `<li>Nodo: ${esc(ex.lastNodeExecuted || err.node?.name || '?')}</li>`\n  + `<li>Errore: ${esc(err.message || JSON.stringify(err).slice(0, 300))}</li>`\n  + `<li>Esecuzione: ${esc(ex.url || ex.id || '')}</li></ul>`\n  + '<p>Le righe gia\\' scritte nel foglio sono corrette; quelle non ancora scritte non sono state inviate, '\n  + 'oppure lo sono ma il controllo su Gmail Inviati le blocca al prossimo giro. Controlla la colonna Status.</p>';\nreturn [{ json: { subject: 'Airbus outreach: errore in ' + (wf.name || 'workflow'), html } }];\n"
      }
    },

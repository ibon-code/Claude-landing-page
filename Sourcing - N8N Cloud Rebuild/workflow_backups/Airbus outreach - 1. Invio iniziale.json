    {
      "id": "f2850303-d2eb-4de1-8e0e-77b9d7fc2c0b",
      "name": "Check Row Unchanged",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2150,
        0
      ],
      "parameters": {
        "jsCode": "const TZ = 'Europe/Madrid';\nfunction madrid(d) {\n  const p = Object.fromEntries(new Intl.DateTimeFormat('en-GB', { timeZone: TZ, year: 'numeric', month: '2-digit',\n    day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23', weekday: 'short' })\n    .formatToParts(d).map(x => [x.type, x.value]));\n  return { s: `${p.year}-${p.month}-${p.day} ${p.hour}:${p.minute}`, date: `${p.year}-${p.month}-${p.day}`, wd: p.weekday };\n}\nconst str = v => String(v ?? '').trim();\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst splitList = v => str(v).split(/[,;]/).map(s => s.trim()).filter(Boolean);\nconst EMAIL_RE = /^[^@\\s<>(),;:\"]+@[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}$/;\nconst PLACEHOLDER_RE = /\\[[^\\]]*\\]|\\{\\{|\\}\\}|\\bundefined\\b|\\bNaN\\b/;\nconst e = $('Check Already Sent').first();\nif (!e.json.okToSend) return [e];\nconst r = $input.all().map(i => i.json).find(x => str(x['Startup name']) === e.json.name);\nlet why = '';\nif (!r) why = 'row not found on re-read, not sent';\nelse if (str(r['Status']) !== 'Ready') why = 'Status is now ' + (str(r['Status']) || 'empty') + ', not sent';\nelse if (str(r['Sent at'])) why = 'Sent at already set, not sent';\nelse if (splitList(r['To']).join(', ') !== e.json.realTo || splitList(r['CC']).join(', ') !== e.json.realCc\n         || str(r['Subject']) !== e.json.rawSubject || str(r['Body HTML']) !== e.json.rawHtml) why = 'row changed during the run, not sent';\nif (why) return [{ json: { ...e.json, okToSend: false, blockReason: why }, binary: e.binary }];\nreturn [e];\n"
      }

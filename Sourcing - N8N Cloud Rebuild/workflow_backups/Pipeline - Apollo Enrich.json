    {
      "name": "Select Rows to Enrich",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const MAX_PER_RUN = 10;\nconst SOURCE_DOMAINS = new Set(['betalist.com', 'tech.eu', 'wamda.com', 'linkedin.com']);\nfunction domainOf(url) {\n  const d = String(url || '').trim().toLowerCase()\n    .replace(/^https?:\\/\\//, '').replace(/^www\\./, '').split('/')[0].split('?')[0];\n  return SOURCE_DOMAINS.has(d) ? '' : d;\n}\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const name = String(j['Startup name'] || '').trim();\n  if (!name) continue;\n  if (String(j['Email'] || '').trim()) continue;          // already has a contact\n  if (String(j['Apollo Enrich'] || '').trim()) continue;  // already attempted\n  out.push({ json: { row_number: j.row_number, name, domain: domainOf(j['Website']) } });\n  if (out.length >= MAX_PER_RUN) break;\n}\nreturn out;\n"
      },
      "id": "f1748d8b-62c2-479c-9c07-8ccdfe16c64f"
    },
    {
      "name": "Apollo - Find Company",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.apollo.io/api/v1/mixed_companies/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.domain ? { q_organization_domains_list: [$json.domain], per_page: 1 } : { q_organization_name: $json.name, per_page: 5 }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "tsTg37ICmuv8HBpC",
          "name": "Apollo Header Auth"
        }
      },
      "continueOnFail": true,
      "onError": "continueRegularOutput",
      "id": "31e0efcd-665c-455f-8e58-6a1926e013ac"
    },
    {
      "name": "Resolve Domain",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "// Rows that already had a real domain pass through; the others take the domain of the\n// Apollo company whose name matches exactly (never a fuzzy match, to avoid wrong contacts).\nconst norm = s => String(s || '').toLowerCase().replace(/[^a-z0-9]/g, '');\nconst rows = $('Select Rows to Enrich').all();\nconst out = [];\n$input.all().forEach((item, i) => {\n  const row = rows[i].json;\n  let domain = row.domain, resolvedWebsite = '';\n  if (!domain) {\n    const orgs = item.json.organizations || item.json.accounts || [];\n    const hit = orgs.find(o => norm(o.name) === norm(row.name) && o.primary_domain);\n    if (hit) { domain = hit.primary_domain; resolvedWebsite = 'https://' + hit.primary_domain; }\n  }\n  out.push({ json: { ...row, domain, resolvedWebsite } });\n});\nreturn out;\n"
      },
      "id": "a3724341-7363-4b11-90c7-0736343506e7"
    },
    {
      "name": "With Domain",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -120
      ],
      "parameters": {
        "jsCode": "return $input.all().filter(it => it.json.domain);"
      },
      "id": "1a577a24-3ff9-4330-a9af-16ddfcf0bc27"
    },
    {
      "name": "No Domain",
      "type": "n8n-nodes-base.code",

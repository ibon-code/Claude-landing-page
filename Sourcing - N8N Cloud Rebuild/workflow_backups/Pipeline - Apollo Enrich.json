    {
      "name": "Build Found Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        -240
      ],
      "parameters": {
        "jsCode": "const rows = $('Has Candidate').all();\nconst out = [];\n$input.all().forEach((item, i) => {\n  const row = rows[i].json;\n  const p = item.json.person || {};\n  const upd = { row_number: row.row_number };\n  if (row.resolvedWebsite) upd['Website'] = row.resolvedWebsite;\n  if (p.email) {\n    upd['Email'] = p.email;\n    upd['Full Name'] = p.name || [p.first_name, p.last_name].filter(Boolean).join(' ');\n    upd['Job title'] = p.title || p.headline || '';\n    upd['Apollo Enrich'] = 'Found - ' + new Date().toISOString().slice(0, 10);\n  } else {\n    upd['Apollo Enrich'] = 'Email not revealed - ' + new Date().toISOString().slice(0, 10);\n  }\n  out.push({ json: upd });\n});\nreturn out;\n"
      },
      "id": "08b2d9cb-3519-4786-9b0f-0f5a72aeae77"
